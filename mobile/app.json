{
  "expo": {
    "name": "Motif",
    "slug": "motif",
    "scheme": "motif",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.fleur.motif"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {},
    "plugins": [
      "expo-video",
      "expo-secure-store",
      "expo-image"
    ]
  }
}
