// fleur-creative — Creative Intelligence
//
// A deliberately self-contained database. This app never reads the Fleur
// Financials database: it syncs the Meta data it needs straight from the Meta
// API into its own tables, so no sales, order, customer or user data from the
// financials app is reachable from here. That separation is the reason the app
// was split out.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ── Auth ─────────────────────────────────────────────────────────────────────

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String?
  passwordHash String?
  isAdmin      Boolean   @default(false)
  status       String    @default("invited") // invited | active | disabled

  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  sessions        Session[]
  savedReferences SavedReference[]

  @@index([status])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// ── Meta mirror ──────────────────────────────────────────────────────────────
// Synced directly from the Meta Marketing API by this app. Only what the
// campaign view needs: the entity tree and ad/campaign delivery.

model MetaEntity {
  id               String   @id // Meta campaign/adset/ad id
  level            String   // "campaign" | "adset" | "ad"
  name             String
  campaignId       String?
  adsetId          String?
  status           String?
  effectiveStatus  String?
  objective        String?
  dailyBudget      Decimal? @db.Decimal(12, 2)
  lifetimeBudget   Decimal? @db.Decimal(12, 2)
  creativeThumbUrl String?
  syncedAt         DateTime @default(now())

  @@index([level])
  @@index([campaignId])
  @@index([adsetId])
}

model MetaInsightDaily {
  id               String   @id
  date             DateTime @db.Date
  level            String   // "account" | "campaign" | "adset" | "ad"
  entityId         String
  spend            Decimal  @db.Decimal(12, 2)
  impressions      Int
  reach            Int
  clicks           Int
  inlineLinkClicks Int
  outboundClicks   Int
  purchases        Int
  purchaseValue    Decimal  @db.Decimal(12, 2)
  addToCart        Int
  initiateCheckout Int
  landingPageViews Int
  videoViews3s     Int
  thruplays        Int
  videoP25         Int
  videoP50         Int
  videoP75         Int
  videoP100        Int
  currency         String   @default("USD")
  syncedAt         DateTime @default(now())

  @@unique([date, level, entityId])
  @@index([date, level])
  @@index([entityId])
}

model SyncLog {
  id              String    @id @default(cuid())
  source          String
  startedAt       DateTime  @default(now())
  finishedAt      DateTime?
  status          String    @default("running")
  recordsUpserted Int       @default(0)
  errorMessage    String?

  @@index([source, startedAt])
}

// ── Creative intelligence ────────────────────────────────────────────────────

model CreativeAsset {
  id             String   @id @default(cuid())
  assetKey       String   @unique
  assetType      String   // "video" | "image"
  name           String
  adIds          String[]
  thumbUrl       String?
  headline       String?
  primaryText    String?  @db.Text
  destinationUrl String?
  durationSec    Float?

  firstSeen DateTime @default(now())
  lastSeen  DateTime @default(now())

  attempts  Int     @default(0)
  lastError String?

  analysis CreativeAnalysis?

  @@index([assetType])
}

model CreativeAnalysis {
  id      String        @id @default(cuid())
  assetId String        @unique
  asset   CreativeAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  transcript String? @db.Text
  synopsis   String? @db.Text
  hookText   String? @db.Text

  pillar          String
  pillarConf      Float
  pillarReason    String? @db.Text
  secondaryPillar String?
  persona         String
  personaConf     Float
  hook            String
  hookConf        Float
  funnel          String
  funnelConf      Float
  awareness       String
  format          String
  production      String
  placementFit    String

  hookStrength        Int
  messageClarity      Int
  differentiation     Int
  productionQuality   Int
  placementNativeness Int

  complianceFlags   String[]
  critique          String?  @db.Text
  suggestedAdjacent String[]

  reviewedBy String?
  reviewedAt DateTime?

  model      String
  analyzedAt DateTime @default(now())

  @@index([pillar])
  @@index([persona])
  @@index([funnel])
}

model CreativeRun {
  id          String    @id @default("singleton")
  status      String    @default("idle") // idle | running | stopped | done | error
  startedAt   DateTime?
  finishedAt  DateTime?
  heartbeatAt DateTime?
  processed   Int       @default(0)
  failed      Int       @default(0)
  lastError   String?
  token       String?
}

// ── Reference library (competitor / market creative) ──────────────────────────
//
// Durable, high-reach video ads pulled from TrendTrack — OTHER brands' proven
// creative, used to inspire and brief Fleur's own creators. Kept in its own
// tables, entirely separate from CreativeAsset/CreativeAnalysis, because those
// drive Fleur's portfolio coverage/gaps math and competitor creative must never
// enter that calculation.
//
// We store every field TrendTrack returns (plus the untouched payload in `raw`,
// so a field we don't model yet is never lost) and mirror the video into our own
// storage — TrendTrack/Meta media URLs are signed and expire within days, so a
// saved source URL cannot be served to a creator later.

model ReferenceAsset {
  id          String @id @default(cuid())
  ttAdId      String @unique // TrendTrack ad id — the upsert key
  collationId String? // TrendTrack's dedupe group across variants
  platform    String? // facebook | tiktok | google

  advertiserName String?
  advertiserId   String?

  mediaType   String // video | image | carousel
  // Source URLs are what TrendTrack gave us; they expire. Kept for re-mirroring.
  sourceMediaUrl String? @db.Text
  sourceThumbUrl String? @db.Text
  // Our permanent copies in Supabase Storage. Null until mirrored.
  mediaUrl    String? @db.Text
  thumbUrl    String? @db.Text
  mediaBytes  Int?
  durationSec Float?

  title          String? @db.Text
  body           String? @db.Text
  transcript     String? @db.Text
  landingPageUrl String? @db.Text
  cta            String?

  // Durability / scale signals — the reason a reference ad earns its place.
  reach         Int?
  estSpend      Float?
  daysRunning   Int?
  variants      Int? // TrendTrack "duplicates": how many variants the brand runs
  reachDelta7d  Int?
  reachDelta30d Int?

  gender      String?
  ageMin      Int?
  ageMax      Int?
  countries   String[]
  mainCountry String?

  // The complete TrendTrack record, so no field is ever lost to our schema.
  raw Json

  firstSeen DateTime @default(now())
  lastSeen  DateTime @default(now())

  // Mirror + analysis bookkeeping, mirroring CreativeAsset's retry fields.
  attempts  Int     @default(0)
  lastError String?

  // Cached creative framework (the "how to remake this for Fleur" brief). Same
  // for every creator — it's about the video + Fleur, not the user — so it's
  // generated once and reused. See lib/reference/framework.ts.
  framework   Json?
  frameworkAt DateTime?

  analysis ReferenceAnalysis?
  saves    SavedReference[]

  @@index([mediaType])
  @@index([advertiserName])
  @@index([daysRunning])
  @@index([reach])
}

// A creator's swipe decision on a reference ad. Right-swipe saves it to their
// shot list; left-swipe dismisses it so the deck doesn't repeat. "filmed" marks
// a saved idea they've since shot.
model SavedReference {
  id        String   @id @default(cuid())
  userId    String
  assetId   String
  status    String   @default("saved") // saved | dismissed | filmed
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  asset ReferenceAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([userId, assetId])
  @@index([userId, status])
}

// Our own classification of a reference asset, against the same taxonomy as
// CreativeAnalysis. Indexed on the swipe app's lookup axes: the creator picks a
// thin pillar × persona × funnel and we serve reference assets in that cell.
model ReferenceAnalysis {
  id      String         @id @default(cuid())
  assetId String         @unique
  asset   ReferenceAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  synopsis String? @db.Text
  hookText String? @db.Text

  pillar          String
  pillarConf      Float
  pillarReason    String? @db.Text
  secondaryPillar String?
  persona         String
  personaConf     Float
  hook            String
  hookConf        Float
  funnel          String
  funnelConf      Float
  awareness       String
  format          String
  production      String
  placementFit    String

  hookStrength        Int
  messageClarity      Int
  differentiation     Int
  productionQuality   Int
  placementNativeness Int

  complianceFlags   String[]
  critique          String?  @db.Text
  suggestedAdjacent String[]

  model      String
  analyzedAt DateTime @default(now())

  @@index([pillar])
  @@index([persona])
  @@index([funnel])
  @@index([format])
}
