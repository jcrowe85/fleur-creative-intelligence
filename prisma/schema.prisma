// fleur-creative — Creative Intelligence
//
// A deliberately self-contained database. This app never reads the Fleur
// Financials database: it syncs the Meta data it needs straight from the Meta
// API into its own tables, so no sales, order, customer or user data from the
// financials app is reachable from here. That separation is the reason the app
// was split out.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ── Auth ─────────────────────────────────────────────────────────────────────

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String?
  passwordHash String?
  isAdmin      Boolean   @default(false)
  status       String    @default("invited") // invited | active | disabled

  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  sessions Session[]

  @@index([status])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// ── Meta mirror ──────────────────────────────────────────────────────────────
// Synced directly from the Meta Marketing API by this app. Only what the
// campaign view needs: the entity tree and ad/campaign delivery.

model MetaEntity {
  id               String   @id // Meta campaign/adset/ad id
  level            String   // "campaign" | "adset" | "ad"
  name             String
  campaignId       String?
  adsetId          String?
  status           String?
  effectiveStatus  String?
  objective        String?
  dailyBudget      Decimal? @db.Decimal(12, 2)
  lifetimeBudget   Decimal? @db.Decimal(12, 2)
  creativeThumbUrl String?
  syncedAt         DateTime @default(now())

  @@index([level])
  @@index([campaignId])
  @@index([adsetId])
}

model MetaInsightDaily {
  id               String   @id
  date             DateTime @db.Date
  level            String   // "account" | "campaign" | "adset" | "ad"
  entityId         String
  spend            Decimal  @db.Decimal(12, 2)
  impressions      Int
  reach            Int
  clicks           Int
  inlineLinkClicks Int
  outboundClicks   Int
  purchases        Int
  purchaseValue    Decimal  @db.Decimal(12, 2)
  addToCart        Int
  initiateCheckout Int
  landingPageViews Int
  videoViews3s     Int
  thruplays        Int
  videoP25         Int
  videoP50         Int
  videoP75         Int
  videoP100        Int
  currency         String   @default("USD")
  syncedAt         DateTime @default(now())

  @@unique([date, level, entityId])
  @@index([date, level])
  @@index([entityId])
}

model SyncLog {
  id              String    @id @default(cuid())
  source          String
  startedAt       DateTime  @default(now())
  finishedAt      DateTime?
  status          String    @default("running")
  recordsUpserted Int       @default(0)
  errorMessage    String?

  @@index([source, startedAt])
}

// ── Creative intelligence ────────────────────────────────────────────────────

model CreativeAsset {
  id             String   @id @default(cuid())
  assetKey       String   @unique
  assetType      String   // "video" | "image"
  name           String
  adIds          String[]
  thumbUrl       String?
  headline       String?
  primaryText    String?  @db.Text
  destinationUrl String?
  durationSec    Float?

  firstSeen DateTime @default(now())
  lastSeen  DateTime @default(now())

  attempts  Int     @default(0)
  lastError String?

  analysis CreativeAnalysis?

  @@index([assetType])
}

model CreativeAnalysis {
  id      String        @id @default(cuid())
  assetId String        @unique
  asset   CreativeAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  transcript String? @db.Text
  synopsis   String? @db.Text
  hookText   String? @db.Text

  pillar          String
  pillarConf      Float
  pillarReason    String? @db.Text
  secondaryPillar String?
  persona         String
  personaConf     Float
  hook            String
  hookConf        Float
  funnel          String
  funnelConf      Float
  awareness       String
  format          String
  production      String
  placementFit    String

  hookStrength        Int
  messageClarity      Int
  differentiation     Int
  productionQuality   Int
  placementNativeness Int

  complianceFlags   String[]
  critique          String?  @db.Text
  suggestedAdjacent String[]

  reviewedBy String?
  reviewedAt DateTime?

  model      String
  analyzedAt DateTime @default(now())

  @@index([pillar])
  @@index([persona])
  @@index([funnel])
}

model CreativeRun {
  id          String    @id @default("singleton")
  status      String    @default("idle") // idle | running | stopped | done | error
  startedAt   DateTime?
  finishedAt  DateTime?
  heartbeatAt DateTime?
  processed   Int       @default(0)
  failed      Int       @default(0)
  lastError   String?
  token       String?
}
